# Copy to .env and fill in values.
# Local: `docker compose up -d` then use the URL below (see docker-compose.yml).
# Render: set DATABASE_URL to the PostgreSQL "Internal Database URL" from the Render dashboard.
DATABASE_URL="postgresql://secondreader:secondreader@localhost:5432/secondreader"

NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

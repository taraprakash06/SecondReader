generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  WRITER
  READER
  BOTH
}

enum DraftStage {
  EARLY_DRAFT
  POLISHED_DRAFT
  PRE_SUBMISSION
}

enum FeedbackFocus {
  BIG_PICTURE
  LINE_EDITS
  EMOTIONAL_IMPACT
  STRUCTURE
  OTHER
}

/// Writer-selected focus areas on submit (up to 5). Stored as JSON array on Submission.writerFocusAreas.
enum WriterFocusArea {
  BIG_PICTURE_OVERALL
  STRUCTURE_PACING
  CLARITY_FLOW
  CHARACTER_VOICE
  EMOTIONAL_IMPACT
  LINE_LEVEL_WRITING
  DIALOGUE
  OPENING_FIRST_PAGES
  ENDING
  PLACES_WORKING_WELL
  PLACES_CONFUSION
  PLACES_UNNECESSARY
  OTHER
}

enum FeedbackTonePreference {
  GENTLE
  BALANCED
  DIRECT
}

enum ReaderAgeCategory {
  TEEN
  ADULT
  SENIOR
  UNSPECIFIED
}

enum CritiqueStatus {
  ACTIVE
  STOPPED
  COMPLETED
}

enum ReaderInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReaderVolunteerStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReputationTag {
  BIG_PICTURE_THINKING
  LINE_LEVEL_DETAIL
  ENCOURAGING_TONE
  BRUTALLY_HONEST
  GOOD_WITH_PACING
  GOOD_WITH_POETRY
  GOOD_WITH_PROSE
}

enum SampleGenre {
  FICTION
  PERSONAL_ESSAY_MEMOIR
  POETRY
  LITERARY_NONFICTION
  GENRE_FICTION
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  bio       String   @default("")
  role      UserRole @default(WRITER)
  passwordHash String?
  writeGenres String @default("") // comma-separated for MVP
  readGenres  String @default("") // comma-separated for MVP
  onboarded   Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readerProfile ReaderProfile?

  submissions Submission[]         @relation("WriterSubmissions")
  assignments CritiqueAssignment[] @relation("ReaderAssignments")

  readerInvitesReceived ReaderInvite[] @relation("ReaderInvitesReceived")
  readerInvitesSent     ReaderInvite[] @relation("ReaderInvitesSent")
  volunteerRequestsAsReader ReaderVolunteerRequest[] @relation("VolunteerReader")
  volunteerRequestsForWriter ReaderVolunteerRequest[] @relation("VolunteerWriter")
  notifications         Notification[]

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ReaderProfile {
  id                 String            @id @default(cuid())
  userId             String            @unique
  ageCategory        ReaderAgeCategory @default(UNSPECIFIED)
  writingBackground  String            @default("")
  genres             String            @default("") // comma-separated for MVP
  caresAbout         String            @default("")
  feedbackPhilosophy String            @default("")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbackSamples FeedbackSample[]
}

model Submission {
  id           String        @id @default(cuid())
  writerId     String
  title        String
  genre        String
  subgenre     String        @default("")
  wordCount    Int
  stage        DraftStage
  /// JSON array of WriterFocusArea values (1–5 items).
  writerFocusAreas String @default("[]")
  focus1       FeedbackFocus
  focus2       FeedbackFocus?
  focusOther   String        @default("")
  tonePref     FeedbackTonePreference
  notHelpful   String        @default("")
  /// Optional short note shown on Browse Pieces (e.g. worries, context for volunteers).
  writerBrowseNote String   @default("")
  /// When false, the piece is hidden from Browse Pieces and volunteers cannot request.
  requestsOpen Boolean       @default(true)
  initialPages String        // gated content (<= ~3 pages)
  fullText     String        @default("") // optional: additional pages unlocked later
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  writer      User                @relation("WriterSubmissions", fields: [writerId], references: [id], onDelete: Cascade)
  assignments CritiqueAssignment[]
  invites     ReaderInvite[]
  volunteerRequests ReaderVolunteerRequest[]
}

model CritiqueAssignment {
  id            String         @id @default(cuid())
  submissionId  String
  readerId      String
  status        CritiqueStatus @default(ACTIVE)
  unlockedPages Int            @default(3)
  /// When true, the reader may read `Submission.fullText` in addition to initial pages.
  readerSeesFullPiece Boolean  @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reader     User       @relation("ReaderAssignments", fields: [readerId], references: [id], onDelete: Cascade)

  feedback CritiqueFeedback?
  tags     FeedbackTag[]

  @@unique([submissionId, readerId])
  @@index([readerId, status])
}

model ReaderInvite {
  id           String             @id @default(cuid())
  submissionId String
  readerId     String
  writerId     String
  status       ReaderInviteStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reader       User          @relation("ReaderInvitesReceived", fields: [readerId], references: [id], onDelete: Cascade)
  writer       User          @relation("ReaderInvitesSent", fields: [writerId], references: [id], onDelete: Cascade)
  notification Notification?

  @@unique([submissionId, readerId])
  @@index([readerId, status])
}

model ReaderVolunteerRequest {
  id           String               @id @default(cuid())
  submissionId String
  readerId     String
  writerId     String
  status       ReaderVolunteerStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reader     User       @relation("VolunteerReader", fields: [readerId], references: [id], onDelete: Cascade)
  writer     User       @relation("VolunteerWriter", fields: [writerId], references: [id], onDelete: Cascade)
  notification Notification?

  @@unique([submissionId, readerId])
  @@index([writerId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  inviteId  String?  @unique
  volunteerRequestId String? @unique
  /// Set when a volunteer request is accepted so the reader can open /critiques/[id].
  relatedAssignmentId String?
  createdAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invite ReaderInvite? @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  volunteerRequest ReaderVolunteerRequest? @relation(fields: [volunteerRequestId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model CritiqueFeedback {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  strengths    String   @default("")
  improvements String   @default("")
  keyTakeaways String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment CritiqueAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  comments   InlineComment[]
}

model InlineComment {
  id         String   @id @default(cuid())
  feedbackId String
  quote      String   @default("")
  message    String
  createdAt  DateTime @default(now())

  feedback CritiqueFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model FeedbackTag {
  id           String        @id @default(cuid())
  assignmentId String
  tag          ReputationTag
  createdAt    DateTime      @default(now())

  assignment CritiqueAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, tag])
}

model SamplePiece {
  id        String      @id @default(cuid())
  title     String      @unique
  genre     SampleGenre @default(FICTION)
  text      String
  createdAt DateTime    @default(now())

  samples FeedbackSample[]
}

model FeedbackSample {
  id                 String      @id @default(cuid())
  readerProfileId    String
  samplePieceId      String
  genre              SampleGenre @default(FICTION)
  publicStrengths    String      @default("")
  publicImprovements String      @default("")
  publicKeyTakeaways String      @default("")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  readerProfile ReaderProfile @relation(fields: [readerProfileId], references: [id], onDelete: Cascade)
  samplePiece   SamplePiece   @relation(fields: [samplePieceId], references: [id], onDelete: Cascade)
  comments      SampleInlineComment[]

  @@index([readerProfileId, createdAt])
}

model SampleInlineComment {
  id               String   @id @default(cuid())
  feedbackSampleId String
  quote            String   @default("")
  message          String
  createdAt        DateTime @default(now())

  feedbackSample FeedbackSample @relation(fields: [feedbackSampleId], references: [id], onDelete: Cascade)
}
